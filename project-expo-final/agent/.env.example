# =============================================================================
# Agent Research Backend — Environment Variables
# =============================================================================

# NVIDIA NIM API Keys (multi-key round-robin for throughput scaling)
# 2 keys from 2 accounts = 2× throughput
NVIDIA_API_KEY_1=nvapi-xxxxx
NVIDIA_API_KEY_2=nvapi-xxxxx

# Or single key (fallback)
# NIM_API_KEY=nvapi-xxxxx

# Model overrides (optional — defaults are good)
# NIM_CHAT_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# NIM_FAST_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Brave Search API (optional — falls back to DuckDuckGo)
# BRAVE_API_KEY=BSA-xxxxx

# GitHub (optional — for code retriever block)
# GITHUB_TOKEN=ghp_xxxxx

# Server
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
# AGENT_DEBUG=true

# Cache & KB storage paths (optional — defaults to ~/.agent_cache and ~/.agent_kb)
# AGENT_CACHE_DIR=./cache
# AGENT_KB_DIR=./kb
